# ─── VARIÁVEIS OBRIGATÓRIAS ───────────────────────────────────────────────────
# Cole estas variáveis em: Railway → seu projeto → Variables

# Chave secreta para assinar os tokens de sessão (gere uma string aleatória longa)
JWT_SECRET=coloque-aqui-uma-string-secreta-longa-e-aleatoria

# Conteúdo COMPLETO do arquivo JSON da sua Service Account do Google Cloud
# (cole o JSON todo em uma única linha, sem quebras de linha)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"youRH@youRH-dashboard.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ID da planilha do Google Sheets (já configurado com o painel YouRH)
SPREADSHEET_ID=1kjwjwQF8KL2ijEt9jB-UkWYLmLTZ5XuF6k44sAFzAgU

# Nome da aba na planilha (verifique o nome exato na barra de abas do Sheets)
SHEET_NAME=Sheet1

# ─── USUÁRIOS ─────────────────────────────────────────────────────────────────
# JSON com lista de usuários. Para gerar o hash de senha, rode:
#   node scripts/hash-password.js <sua-senha>
#
# Papéis disponíveis:
#   rh_admin   — vê todos os colaboradores e setores
#   gestor     — vê apenas o setor definido em "setor"
#   colaborador — vê apenas os próprios dados (campo "nome" deve bater com o nome na planilha)

USERS=[{"email":"admin@suaempresa.com","nome":"Admin RH","role":"rh_admin","setor":null,"password":"$2b$10$HASH_GERADO_AQUI"},{"email":"gestor.tech@suaempresa.com","nome":"Gestor Tech","role":"gestor","setor":"Tech","password":"$2b$10$HASH_GERADO_AQUI"},{"email":"fernanda@suaempresa.com","nome":"Fernanda Crespo","role":"colaborador","setor":"Vendas","password":"$2b$10$HASH_GERADO_AQUI"}]

# ─── OPCIONAL ─────────────────────────────────────────────────────────────────
NODE_ENV=production
